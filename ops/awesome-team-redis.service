[Unit]
Description=Awesome Deploy shared sessions Redis
After=network.target

[Service]
User=redis
Group=redis
ExecStart=/usr/bin/redis-server /etc/redis/awesome-team.conf --daemonize no
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/redis-awesome-team
MemoryMax=160M

[Install]
WantedBy=multi-user.target
