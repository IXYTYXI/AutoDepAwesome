#!/usr/bin/python3 -I
"""Install root:root 0755 at /usr/local/libexec/awesome-gateway; never sudo a checkout.

No shell or package imports. Request protocol contains no paths or command arguments.
All gateway mutations, verification and certificate renewal share one global flock.
"""

import fcntl
import http.client
import json
import os
from pathlib import Path
import re
import secrets
import socket
import ssl
import stat
import subprocess
import sys
import tempfile
import time

CONFIG_FILE = Path("/etc/awesome-deploy/gateway.json")
STATE = Path("/var/lib/awesome-gateway")
NGINX_DIR = Path("/etc/nginx/conf.d")
WEBROOT = Path("/var/www/awesome-acme")
PROBE_LOG = Path("/var/log/nginx/awesome-gateway-probes.log")
PROBE_LOGGING = (
    'log_format awesome_probe escape=json \'{"probe":"$http_x_awesome_probe",'
    '"upstream":"$upstream_addr","host":"$host","uri":"$uri","status":$status,"pid":$pid}\';\n'
    'map $http_x_awesome_probe $awesome_is_probe { default 0; "~^[0-9a-f]{64}$" 1; }\n'
)
NGINX_PID = Path("/run/nginx.pid")
PROC = Path("/proc")
NGINX = "/usr/sbin/nginx"
CERTBOT = "/usr/bin/certbot"
CONFIG = {}
LOCK_FD = None
NAME = re.compile(r"[a-z0-9](?:[a-z0-9-]{0,5}[a-z0-9])?")
RELEASE = re.compile(r"[a-zA-Z0-9_-]{1,64}")
SERVICE = re.compile(r"[a-z][a-z0-9_-]{0,31}")
PATH = re.compile(r"/(?:[a-zA-Z0-9_.~-]+(?:/[a-zA-Z0-9_.~-]+)*/?)?")


def run(args, timeout=180):
    # Output files avoid pipe deadlock; commands and input are always fixed by this helper.
    with tempfile.TemporaryFile() as out:
        process = subprocess.Popen(
            args,
            stdin=subprocess.DEVNULL,
            stdout=out,
            stderr=out,
            env={"PATH": "/usr/sbin:/usr/bin:/sbin:/bin", "LANG": "C.UTF-8"},
            start_new_session=True,
            pass_fds=(LOCK_FD,) if LOCK_FD is not None else (),
        )
        try:
            process.wait(timeout=timeout)
        except subprocess.TimeoutExpired:
            import signal

            os.killpg(process.pid, signal.SIGKILL)
            process.wait()
            raise RuntimeError("Gateway command timed out")
        out.seek(0)
        output = out.read(32768).decode(errors="replace")
        if process.returncode:
            raise RuntimeError(f"{Path(args[0]).name} failed: {output}")
        return output


def atomic(path, content):
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(prefix=".awesome-", dir=path.parent)
    try:
        with os.fdopen(fd, "w") as stream:
            stream.write(content)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, path)
        directory = os.open(path.parent, os.O_DIRECTORY)
        try:
            os.fsync(directory)
        finally:
            os.close(directory)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def validate(req):
    if req == {"op": "check"}:
        return req
    if not isinstance(req, dict) or set(req) != {
        "op",
        "base_domain",
        "subdomain",
        "release",
        "previous_release",
        "ports",
        "routes",
    }:
        raise ValueError("Invalid gateway request fields")
    if req["base_domain"] != CONFIG["base_domain"]:
        raise ValueError("Platform base domain differs from root-owned gateway configuration")
    if req["op"] not in {"ensure_https", "publish", "verify", "rollback", "verify_status", "deactivate", "quarantine"}:
        raise ValueError("Unknown gateway operation")
    if not isinstance(req["subdomain"], str) or not NAME.fullmatch(req["subdomain"]):
        raise ValueError("Invalid subdomain")
    if not isinstance(req["release"], str) or not RELEASE.fullmatch(req["release"]):
        raise ValueError("Invalid release")
    if req["previous_release"] is not None and (
        not isinstance(req["previous_release"], str) or not RELEASE.fullmatch(req["previous_release"])
    ):
        raise ValueError("Invalid previous release")
    ports = req["ports"]
    if not isinstance(ports, dict) or not 1 <= len(ports) <= 16:
        raise ValueError("Invalid ports")
    for name, port in ports.items():
        if (
            not SERVICE.fullmatch(name)
            or type(port) is not int
            or not CONFIG["port_start"] <= port <= CONFIG["port_end"]
        ):
            raise ValueError("Invalid candidate port")
    if len(set(ports.values())) != len(ports):
        raise ValueError("Candidate ports must be distinct")
    if not isinstance(req["routes"], list) or not 1 <= len(req["routes"]) <= 32:
        raise ValueError("Invalid routes")
    seen = set()
    for route in req["routes"]:
        if not isinstance(route, dict) or set(route) != {"path", "match", "service", "stripPrefix"}:
            raise ValueError("Invalid route fields")
        path = route["path"]
        if (
            not isinstance(path, str)
            or not PATH.fullmatch(path)
            or any(part in {".", ".."} for part in path.split("/"))
            or path.rstrip("/") == "/.well-known/acme-challenge"
            or path.startswith("/.well-known/acme-challenge/")
        ):
            raise ValueError("Invalid or reserved route path")
        if (
            route["match"] not in {"exact", "prefix"}
            or type(route["stripPrefix"]) is not bool
            or route["service"] not in ports
        ):
            raise ValueError("Invalid route target")
        key = (path.rstrip("/") or "/", route["match"])
        if key in seen:
            raise ValueError("Duplicate routes")
        seen.add(key)
    return req


def config_path(subdomain):
    return NGINX_DIR / f"awesome-app-{subdomain}.conf"


def read_state(subdomain):
    path = STATE / f"{subdomain}.json"
    return json.loads(path.read_text()) if path.exists() else {"current": None, "pending": None}


def save_state(subdomain, state):
    atomic(STATE / f"{subdomain}.json", json.dumps(state, sort_keys=True))


def host(req):
    return f"{req['subdomain']}.{CONFIG['base_domain']}"


def render(req, tls, *, legacy=False):
    validate(req)
    domain = host(req)
    acme = f"location ^~ /.well-known/acme-challenge/ {{ root {WEBROOT}; default_type text/plain; }}"
    http = f"server {{ listen 80; server_name {domain}; {acme} location / {{ return 404; }} }}\n"
    if not tls:
        return http
    http = f"server {{ listen 80; server_name {domain}; {acme} location / {{ return 308 https://{domain}$request_uri; }} }}\n"
    lines = [
        http,
        "server {",
        f"listen 443 ssl; server_name {domain};",
        f"ssl_certificate /etc/letsencrypt/live/{domain}/fullchain.pem;",
        f"ssl_certificate_key /etc/letsencrypt/live/{domain}/privkey.pem;",
        "ssl_protocols TLSv1.2 TLSv1.3;",
        f"access_log {PROBE_LOG} awesome_probe if=$awesome_is_probe;",
        acme,
    ]
    # Explicit exact locations beat overlapping prefix rules; normalize trailing slash.
    exact_paths = {r["path"] for r in req["routes"] if r["match"] == "exact"}
    for route in req["routes"]:
        path = route["path"]
        port = req["ports"][route["service"]]
        if route["match"] == "exact":
            locations = [("=", path)]
        elif path == "/":
            locations = [("^~", "/")]
        else:
            base = path.rstrip("/")
            locations = ([] if base in exact_paths or path.endswith("/") else [("=", base)]) + [
                ("^~", base + "/")
            ]
        for modifier, location in locations:
            suffix = "/" if route["stripPrefix"] else ""
            lines.extend(
                [
                    f"location {modifier} {location} {{",
                    f"proxy_pass http://127.0.0.1:{port}{suffix};",
                    "proxy_set_header Host $host;",
                    "proxy_set_header X-Forwarded-Proto https;",
                    "proxy_set_header X-Forwarded-For $remote_addr;",
                    "proxy_connect_timeout 5s;",
                    "proxy_read_timeout 60s;" if legacy else "proxy_read_timeout 300s;",
                    *([] if legacy else ["proxy_buffering off;"]),
                    "proxy_redirect off;",
                    "}",
                ]
            )
    if not any(r["path"] == "/" and r["match"] == "prefix" for r in req["routes"]):
        lines.append("location / { return 404; }")
    lines.append("}\n")
    return "\n".join(lines)


def apply_config(subdomain, content):
    path = config_path(subdomain)
    old = path.read_text() if path.exists() else None
    if content is None:
        path.unlink(missing_ok=True)
    else:
        atomic(path, content)
    try:
        run([NGINX, "-t"])
        run([NGINX, "-s", "reload"])
    except Exception as error:
        if old is None:
            path.unlink(missing_ok=True)
        else:
            atomic(path, old)
        try:
            run([NGINX, "-t"])
            run([NGINX, "-s", "reload"])
        except Exception as restore_error:
            raise RuntimeError(
                f"Gateway update failed AND restoring prior config failed: {restore_error}"
            ) from error
        raise


def same_route(first, second):
    return all(first[key] == second[key] for key in ("base_domain", "subdomain", "release", "ports", "routes"))


def deactivation_record(record):
    if record is None:
        return None
    if (
        not isinstance(record, dict)
        or set(record) != {"release", "request", "token", "completed"}
        or type(record["completed"]) is not bool
        or not isinstance(record["token"], str)
        or not re.fullmatch(r"[0-9a-f]{64}", record["token"])
    ):
        raise ValueError("Invalid durable deactivation record")
    validate(record["request"])
    if record["release"] != record["request"]["release"] or record["request"]["op"] != "deactivate":
        raise ValueError("Deactivation record differs from its release")
    return record


def completed_deactivation(state):
    record = deactivation_record(state.get("deactivation"))
    if record and not record["completed"]:
        raise ValueError("Deactivation must be confirmed before another gateway operation")
    return record


def quarantine_records(state):
    records = state.get("quarantines", {})
    if not isinstance(records, dict):
        raise ValueError("Invalid durable quarantine registry")
    for release, record in records.items():
        if (not isinstance(record, dict) or set(record) != {
                "release", "request", "token", "completed", "displaced_release", "previous_config"}
                or record["release"] != release or type(record["completed"]) is not bool
                or not isinstance(record["token"], str) or not re.fullmatch(r"[0-9a-f]{64}", record["token"])
                or (record["previous_config"] is not None and not isinstance(record["previous_config"], str))
                or (record["displaced_release"] is not None and (
                    not isinstance(record["displaced_release"], str)
                    or not RELEASE.fullmatch(record["displaced_release"])))):
            raise ValueError("Invalid durable quarantine record")
        validate(record["request"])
        if record["request"]["release"] != release or record["request"]["op"] != "quarantine":
            raise ValueError("Quarantine record differs from its release")
    return records


def guard_quarantine(req, state, *, restore=False):
    records = quarantine_records(state)
    if any(not record["completed"] for record in records.values()):
        raise ValueError("Quarantine must be confirmed before another gateway operation")
    if req["release"] in records or (restore and req["previous_release"] in records):
        raise ValueError("A quarantined release cannot serve traffic or restore its upstream")


def quarantine(req):
    """Irreversibly isolate one recorded release; never restore a previous upstream.

    Unknown/different-current targets without an earlier completed quarantine are
    deliberately rejected: route probes alone do not prove old workers drained.
    The caller must retain reservations and arrange operator reconciliation.
    """
    validate(req)
    state = read_state(req["subdomain"])
    records = quarantine_records(state)
    if any(not row["completed"] for release, row in records.items() if release != req["release"]):
        raise ValueError("Another release has an unfinished quarantine")
    record = records.get(req["release"])
    current, pending = state["current"], state.get("pending")
    offline = deactivation_record(state.get("deactivation"))
    path = config_path(req["subdomain"])
    content = path.read_text() if path.exists() else None
    if record and not same_route(record["request"], req):
        raise ValueError("Quarantine request differs from its durable release identity")
    if record and record["completed"] and current:
        # Previous completion proved every live worker was isolated, and every
        # normal publication/rollback now rejects that release permanently.
        # Replaying its cleanup must not replace a later unrelated healthy app.
        if (current["release"] == req["release"]
                or (pending and (pending["release"] != current["release"]
                    or (pending.get("previous") or {}).get("release") == req["release"]))
                or content not in [render(current["request"], tls=True, legacy=old) for old in (False, True)]):
            raise ValueError("Completed quarantine conflicts with current gateway state")
        return {"quarantined": True, "release": req["release"],
                "domain_quarantined": False, "displaced_release": None}
    if not record:
        if pending and (pending["release"] != req["release"]
                        or not same_route(pending.get("request"), req)):
            raise ValueError("Quarantine differs from the pending publication identity")
        target_current = current and same_route(current["request"], req)
        target_pending = pending and same_route(pending.get("request"), req)
        target_offline = offline and same_route(offline["request"], req)
        if not (target_current or target_pending or target_offline):
            raise ValueError("No exact current, pending or offline release proves quarantine ownership")
        if current and not target_current and (
                not target_pending or pending.get("previous") != current):
            raise ValueError("Quarantine predecessor differs from the publication journal")
        allowed = [render(req, tls=True, legacy=old) for old in (False, True)]
        if current:
            allowed.extend(render(current["request"], tls=True, legacy=old) for old in (False, True))
        if offline:
            allowed.extend(render_deactivated(offline["request"], offline["token"], legacy=old)
                           for old in (False, True))
        # A first publish can crash after writing its intent but before replacing
        # the root-owned HTTP-only certificate preparation configuration.
        if target_pending and not current and pending.get("previous") is None:
            allowed.append(render(req, tls=False))
        if content not in allowed:
            raise ValueError("Gateway configuration differs from the quarantine release journal")
        record = {"release": req["release"], "request": req, "token": secrets.token_hex(32),
                  "completed": False, "previous_config": content,
                  "displaced_release": current["release"] if current and not target_current else None}
        records[req["release"]] = record
        state["quarantines"] = records
        state["pending"] = None
        state["deactivation"] = {"release": req["release"], "request": {**req, "op": "deactivate"},
                                 "token": record["token"], "completed": False}
        save_state(req["subdomain"], state)
    else:
        expected_current = record["displaced_release"] or req["release"]
        if (content is None or (current and current["release"] != expected_current) or pending
                or not offline or not same_route(offline["request"], req)
                or offline["token"] != record["token"]
                or (record["completed"] and (current or not offline["completed"]))
                or content not in (record["previous_config"], render_deactivated(req, record["token"]))):
            raise ValueError("Quarantine replay differs from the durable isolation intent")
    master, _ = nginx_process_snapshot()
    apply_config(req["subdomain"], render_deactivated(req, record["token"]))
    probe_deactivated(req, record["token"], master=master)
    record["completed"], record["previous_config"] = True, None
    state["deactivation"]["completed"] = True
    state["current"], state["pending"] = None, None
    save_state(req["subdomain"], state)
    return {"quarantined": True, "release": req["release"], "domain_quarantined": True,
            "displaced_release": record["displaced_release"]}


def render_deactivated(req, token, *, legacy=False):
    validate(req)
    if not isinstance(token, str) or not re.fullmatch(r"[0-9a-f]{64}", token):
        raise ValueError("Invalid offline verification token")
    domain = host(req)
    acme = f"location ^~ /.well-known/acme-challenge/ {{ root {WEBROOT}; default_type text/plain; }}"
    worker = "" if legacy else "add_header X-Awesome-Gateway-Worker $pid always; "
    logging = "" if legacy else f"access_log {PROBE_LOG} awesome_probe if=$awesome_is_probe; "
    offline = (f'location / {{ add_header X-Awesome-Offline "{req["release"]}:{token}" always; '
               + worker + "return 410; }")
    return "\n".join([
        f"server {{ listen 80; server_name {domain}; {logging}{acme} {offline} }}",
        "server {",
        f"listen 443 ssl; server_name {domain};",
        f"ssl_certificate /etc/letsencrypt/live/{domain}/fullchain.pem;",
        f"ssl_certificate_key /etc/letsencrypt/live/{domain}/privkey.pem;",
        "ssl_protocols TLSv1.2 TLSv1.3;",
        logging + acme, offline, "}\n",
    ])


def deactivate(req):
    validate(req)
    state = read_state(req["subdomain"])
    guard_quarantine(req, state)
    current, pending = state["current"], state.get("pending")
    record = deactivation_record(state.get("deactivation"))
    if pending and pending["release"] != req["release"]:
        raise ValueError("Refusing deactivation during another release's publication")
    if current and not same_route(current["request"], req):
        raise ValueError("Deactivation does not match the current release and routes")
    if record:
        if not same_route(record["request"], req) or (not current and not record["completed"]):
            raise ValueError("Deactivation differs from the durable offline identity")
    elif not current:
        raise ValueError("No current release or matching completed deactivation exists")
    path = config_path(req["subdomain"])
    content = path.read_text() if path.exists() else None
    # Existing releases keep the exact 0.4.1 config until their next publication.
    allowed = [render(current["request"], tls=True, legacy=legacy) for legacy in (False, True)] if current else []
    if record:
        allowed.append(render_deactivated(record["request"], record["token"]))
        allowed.append(render_deactivated(record["request"], record["token"], legacy=True))
    if content not in allowed:
        raise ValueError("Gateway configuration differs from the release being deactivated")
    if not record:
        record = {"release": req["release"], "request": req, "token": secrets.token_hex(32), "completed": False}
        state["deactivation"] = record
        # A committed application release may retain its old publication rollback
        # journal. Offline intent supersedes it before touching the route.
        state["pending"] = None
        save_state(req["subdomain"], state)
    master, _ = nginx_process_snapshot()
    apply_config(req["subdomain"], render_deactivated(req, record["token"]))
    probe_deactivated(req, record["token"], master=master)
    record["completed"] = True
    state["current"], state["pending"] = None, None
    save_state(req["subdomain"], state)
    return {"deactivated": True, "release": req["release"]}


def publish(req):
    validate(req)
    state = read_state(req["subdomain"])
    guard_quarantine(req, state)
    offline = completed_deactivation(state)
    if offline and offline["release"] == req["release"]:
        raise ValueError("A deactivated release cannot be republished")
    if state["current"] and state["current"]["release"] == req["release"]:
        if (
            state["current"]["request"]["ports"] != req["ports"]
            or state["current"]["request"]["routes"] != req["routes"]
        ):
            raise ValueError("Release already exists with different route content")
        return {"release": req["release"]}
    current_release = state["current"]["release"] if state["current"] else None
    if current_release != req["previous_release"]:
        raise ValueError("Gateway active release differs from the reserved previous release")
    pending = state.get("pending")
    if pending and pending["release"] not in {req["release"], current_release}:
        raise ValueError("Another release has an unfinished publication journal")
    prior_content = (
        config_path(req["subdomain"]).read_text() if config_path(req["subdomain"]).exists() else None
    )
    # Write-ahead state preserves old config even if process dies during replacement/reload.
    if pending and pending["release"] == req["release"]:
        if pending.get("request") and not same_route(pending["request"], req):
            raise ValueError("Pending publication has different route content")
        previous, prior_content = pending["previous"], pending["previous_config"]
        prior_offline = deactivation_record(pending.get("previous_deactivation"))
    else:
        previous = state["current"]
        prior_offline = offline
        if offline and prior_content not in (
            render_deactivated(offline["request"], offline["token"]),
            render_deactivated(offline["request"], offline["token"], legacy=True),
        ):
            raise ValueError("Completed deactivation differs from the current configuration")
    state["pending"] = {"release": req["release"], "request": req, "previous": previous,
                        "previous_config": prior_content, "previous_deactivation": prior_offline}
    save_state(req["subdomain"], state)
    content = render(req, tls=True)
    apply_config(req["subdomain"], content)
    state["current"] = {"release": req["release"], "request": req, "verified": False}
    # The old tombstone remains in pending until publication is durably resolved.
    state.pop("deactivation", None)
    save_state(req["subdomain"], state)
    return {"release": req["release"]}


def rollback(req):
    validate(req)
    state = read_state(req["subdomain"])
    guard_quarantine(req, state, restore=True)
    offline = completed_deactivation(state)
    if offline and offline["release"] == req["release"]:
        raise ValueError("A deactivated release cannot restore its former upstream")
    pending = state.get("pending")
    current_release = state["current"]["release"] if state["current"] else None
    if not pending or pending["release"] != req["release"]:
        if current_release == req["previous_release"]:
            if state["current"]:
                probe_routes(state["current"]["request"])
            elif offline:
                probe_deactivated(offline["request"], offline["token"])
            return {"rolled_back": True}
        raise ValueError("Refusing stale release rollback or missing rollback journal")
    previous_release = pending["previous"]["release"] if pending["previous"] else None
    if previous_release != req["previous_release"] or current_release not in {
        req["release"],
        previous_release,
    }:
        raise ValueError("Rollback journal differs from expected prior release")
    if pending.get("request") and not same_route(pending["request"], req):
        raise ValueError("Rollback request differs from the pending route content")
    prior_offline = deactivation_record(pending.get("previous_deactivation"))
    if prior_offline and (pending["previous"] or not prior_offline["completed"]
                          or pending["previous_config"] not in (
                              render_deactivated(prior_offline["request"], prior_offline["token"]),
                              render_deactivated(prior_offline["request"], prior_offline["token"], legacy=True))):
        raise ValueError("Rollback journal has an inconsistent offline predecessor")
    master = nginx_process_snapshot()[0] if prior_offline else None
    content = (render_deactivated(prior_offline["request"], prior_offline["token"])
               if prior_offline else pending["previous_config"])
    apply_config(req["subdomain"], content)
    # Reload only signals Nginx. Keep the write-ahead journal until fresh TLS
    # requests have actually reached the restored release's upstreams.
    if pending["previous"]:
        probe_routes(pending["previous"]["request"])
    elif prior_offline:
        probe_deactivated(prior_offline["request"], prior_offline["token"], master=master)
    state["current"], state["pending"] = pending["previous"], None
    if prior_offline:
        state["deactivation"] = prior_offline
    save_state(req["subdomain"], state)
    return {"rolled_back": True}


class DeadlineSocket:
    """A socket facade whose file reads share one absolute deadline (including slow headers)."""

    def __init__(self, sock, deadline):
        self.sock, self.deadline = sock, deadline

    def _remaining(self):
        remaining = self.deadline - time.monotonic()
        if remaining <= 0:
            raise TimeoutError("HTTP probe total deadline exceeded")
        self.sock.settimeout(remaining)

    def sendall(self, data):
        self._remaining()
        return self.sock.sendall(data)

    def makefile(self, mode):
        import io

        owner = self

        class Reader(io.RawIOBase):
            def readable(self):
                return True

            def readinto(self, buffer):
                owner._remaining()
                return owner.sock.recv_into(buffer)

        return io.BufferedReader(Reader())

    def close(self):
        self.sock.close()


class LocalHTTPS(http.client.HTTPSConnection):
    def connect(self):
        deadline = time.monotonic() + self.timeout
        sock = socket.create_connection(("127.0.0.1", 443), self.timeout)
        sock.settimeout(max(0.01, deadline - time.monotonic()))
        self.sock = DeadlineSocket(self._context.wrap_socket(sock, server_hostname=self.host), deadline)


class LocalHTTP(http.client.HTTPConnection):
    def connect(self):
        deadline = time.monotonic() + self.timeout
        sock = socket.create_connection(("127.0.0.1", 80), self.timeout)
        self.sock = DeadlineSocket(sock, deadline)


def nginx_pid_identity():
    """Read the fixed, root-owned pidfile without following a replacement link."""
    trusted(NGINX_PID.parent, directory=True)
    oldbin = NGINX_PID.with_name(NGINX_PID.name + ".oldbin")
    if oldbin.exists() or oldbin.is_symlink():
        raise RuntimeError("Nginx oldbin must be reconciled before releasing ports")
    descriptor = os.open(NGINX_PID, os.O_RDONLY | os.O_NOFOLLOW)
    try:
        info = os.fstat(descriptor)
        raw = os.read(descriptor, 65)
        if (not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o022
                or not re.fullmatch(rb"[1-9][0-9]{0,9}\n?", raw)):
            raise RuntimeError("Untrusted Nginx pidfile")
        return int(raw), info.st_dev, info.st_ino
    finally:
        os.close(descriptor)


def nginx_process(pid, binary, pid_namespace):
    """Return a stable Linux process identity; never read process environment."""
    descriptor = None
    try:
        descriptor = os.open(PROC / str(pid), os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
        namespace = os.stat("ns/pid", dir_fd=descriptor)
        # Host /proc also exposes rootless containers' Nginx processes. They do
        # not belong to this gateway. Do not filter mount namespaces: systemd's
        # PrivateTmp can legitimately give the host Nginx a different mount ns.
        if (namespace.st_dev, namespace.st_ino) != pid_namespace:
            return None
        executable = os.readlink("exe", dir_fd=descriptor)
        if executable != NGINX:
            if Path(executable.removesuffix(" (deleted)")).name == "nginx":
                raise RuntimeError("Untrusted or replaced Nginx executable")
            return None
        info = os.stat("exe", dir_fd=descriptor)
        if (info.st_dev, info.st_ino) != binary:
            raise RuntimeError("Nginx executable identity changed")

        def read(name, limit):
            fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW, dir_fd=descriptor)
            try:
                data = os.read(fd, limit + 1)
                if len(data) > limit:
                    raise RuntimeError("Nginx process metadata exceeds its bound")
                return data
            finally:
                os.close(fd)

        def identity():
            raw = read("stat", 4096)
            first, tail = raw.rsplit(b") ", 1)
            fields = tail.split()
            if first != str(pid).encode() + b" (nginx" or len(fields) < 20:
                raise RuntimeError("Invalid Nginx process metadata")
            return pid, int(fields[19]), int(fields[1]), *binary

        before = identity()
        title = read("cmdline", 8192).split(b"\0", 1)[0].decode("ascii")
        status = read("status", 16384)
        uid = re.search(rb"^Uid:\s+([0-9]+)\s+([0-9]+)\s+([0-9]+)\s+([0-9]+)\s*$", status, re.M)
        if uid is None or len(set(uid.groups())) != 1:
            raise RuntimeError("Nginx process user identity is ambiguous")
        if title.startswith("nginx: master process "):
            role = "master"
        elif title in ("nginx: worker process", "nginx: worker process is shutting down"):
            role = "worker"
        elif title in ("nginx: cache manager process", "nginx: cache loader process"):
            role = "cache"
        else:
            raise RuntimeError("Unexpected Nginx process role")
        if identity() != before:
            raise RuntimeError("Nginx process identity changed while reading metadata")
        return {"identity": before, "uid": int(uid.group(1)), "role": role}
    except (FileNotFoundError, ProcessLookupError):
        # An exited process (including a zombie with no exe) cannot open a new upstream.
        return None
    finally:
        if descriptor is not None:
            os.close(descriptor)


def nginx_process_snapshot(expected_master=None):
    """Reject multiple masters and include every current/graceful worker child."""
    trusted(PROC, directory=True)
    trusted(Path(NGINX))
    info = Path(NGINX).stat()
    if not stat.S_ISREG(info.st_mode):
        raise RuntimeError("Nginx executable must be a regular file")
    binary = info.st_dev, info.st_ino
    namespace = (PROC / "self/ns/pid").stat()
    pid_namespace = namespace.st_dev, namespace.st_ino
    pidfile = nginx_pid_identity()
    processes = []
    for entry in PROC.iterdir():
        if re.fullmatch(r"[1-9][0-9]{0,9}", entry.name):
            process = nginx_process(int(entry.name), binary, pid_namespace)
            if process is not None:
                processes.append(process)
    masters = [process for process in processes if process["role"] == "master"]
    if len(masters) != 1 or masters[0]["identity"][0] != pidfile[0] or masters[0]["uid"] != 0:
        raise RuntimeError("A single trusted Nginx master is required")
    master = (*masters[0]["identity"], *pidfile[1:])
    if expected_master is not None and master != expected_master:
        raise RuntimeError("Nginx master identity changed during drain")
    workers = {}
    for process in processes:
        if process["role"] != "master":
            if process["identity"][2] != pidfile[0]:
                raise RuntimeError("Nginx child is outside the trusted master")
            if process["role"] == "worker":
                workers[process["identity"][0]] = process["identity"]
    # Bind the inventory to the same master, pidfile inode and executable at both ends.
    after = Path(NGINX).stat()
    if (nginx_pid_identity() != pidfile or (after.st_dev, after.st_ino) != binary
            or nginx_process(pidfile[0], binary, pid_namespace) != masters[0]):
        raise RuntimeError("Nginx master changed while enumerating workers")
    return master, workers


def probe_deactivated(req, token, *, master=None):
    """Prove the tombstone and drain every live worker within one shared deadline.

    Fresh requests alone prove nothing about a graceful worker still buffering
    an old client's POST. Each surviving identity must itself serve this exact
    tombstone over TLS, with a matching root-controlled, no-upstream log row.
    Repeated full snapshots also include old-cycle respawns around the reload.
    """
    deadline = time.monotonic() + 30
    master, _ = nginx_process_snapshot(master)
    context = ssl.create_default_context()
    paths = list(dict.fromkeys(["/", *probe_paths(req)]))
    pending = {(tls, path) for tls in (True, False) for path in paths}
    marker = f"{req['release']}:{token}"
    expected, observations, proven = {}, {}, set()
    while time.monotonic() < deadline:
        for tls, path in sorted(pending) or [(True, "/")]:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                break
            _, before = nginx_process_snapshot(master)
            args = {"timeout": min(5, remaining)}
            if tls:
                args["context"] = context
            connection = (LocalHTTPS if tls else LocalHTTP)(host(req), **args)
            nonce = secrets.token_hex(32)
            try:
                connection.request("GET", path + "?__awesome_probe=" + nonce,
                                   headers={"X-Awesome-Probe": nonce, "Connection": "close", "Cache-Control": "no-cache"})
                response = connection.getresponse()
                pid = response.getheader("X-Awesome-Gateway-Worker")
                if response.status == 410 and response.getheader("X-Awesome-Offline") == marker:
                    _, after = nginx_process_snapshot(master)
                    if isinstance(pid, str) and re.fullmatch(r"[1-9][0-9]{0,9}", pid):
                        identity = before.get(int(pid))
                        if identity is not None and after.get(int(pid)) == identity:
                            expected[nonce] = {"probe": nonce, "host": host(req), "uri": path,
                                               "upstream": None, "status": 410, "pid": int(pid)}
                            observations[nonce] = ((tls, path), identity)
            except (OSError, http.client.HTTPException):
                pass
            finally:
                connection.close()
        matched, rejected = probe_log_matches(expected)
        for nonce in matched:
            route, identity = observations[nonce]
            pending.discard(route)
            if route[0]:
                proven.add(identity)
        for nonce in matched | rejected:
            expected.pop(nonce, None)
            observations.pop(nonce, None)
        _, workers = nginx_process_snapshot(master)
        if not pending and workers and set(workers.values()) <= proven and time.monotonic() < deadline:
            return
        time.sleep(min(0.1, max(0, deadline - time.monotonic())))
    raise RuntimeError("Offline drain deadline expired before every route and live worker was confirmed")


def probe_paths(req):
    paths = []
    for route in req["routes"]:
        if route["match"] == "exact":
            paths.append(route["path"])
            continue
        for _ in range(10):
            path = route["path"].rstrip("/") + "/" + secrets.token_hex(16)
            overlaps = [
                other
                for other in req["routes"]
                if other is not route
                and (
                    other["match"] == "exact"
                    and path == other["path"]
                    or other["match"] == "prefix"
                    and len(other["path"]) > len(route["path"])
                    and (
                        path == other["path"].rstrip("/") or path.startswith(other["path"].rstrip("/") + "/")
                    )
                )
            ]
            if not overlaps:
                paths.append(path)
                break
        else:
            raise RuntimeError("Cannot choose an unambiguous route probe path")
    return paths


def probe_log_matches(expected):
    """Correlate outstanding requests from this invocation; reject observed mismatches."""
    matched, rejected = set(), set()
    try:
        with PROBE_LOG.open("rb") as stream:
            stream.seek(max(0, os.fstat(stream.fileno()).st_size - 1024 * 1024))
            # Bound reads even while public traffic is still appending to the log.
            lines = stream.read(1024 * 1024).splitlines()
    except FileNotFoundError:
        return matched, rejected
    for line in lines:
        try:
            row = json.loads(line)
        except (ValueError, UnicodeDecodeError):
            continue
        if not isinstance(row, dict):
            continue
        token = row.get("probe")
        if isinstance(token, str) and token in expected:
            wanted = expected[token]
            if all((row.get(key) in ("", "-") if key == "upstream" and value is None else row.get(key) == value)
                   for key, value in wanted.items()):
                matched.add(token)
            else:
                rejected.add(token)
    return matched - rejected, rejected


def probe_routes(req):
    """Confirm all routes within one 30-second budget, including TLS and log waits.

    A reload can briefly accept connections in old workers. Each retry uses a new
    TLS connection and token, so a stale connection or log row cannot prove the
    candidate is serving. Per-request deadlines are capped at five seconds.
    """
    deadline = time.monotonic() + 30
    domain = host(req)
    context = ssl.create_default_context()
    routes = list(zip(req["routes"], probe_paths(req)))
    pending = set(range(len(routes)))
    expected, route_tokens = {}, {}
    while pending and time.monotonic() < deadline:
        for index in sorted(pending):
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                break
            route, path = routes[index]
            token = secrets.token_hex(32)
            connection = LocalHTTPS(domain, timeout=min(5, remaining), context=context)
            try:
                connection.request(
                    "GET",
                    path + "?__awesome_probe=" + token,
                    headers={"X-Awesome-Probe": token, "Connection": "close", "Cache-Control": "no-cache"},
                )
                response = connection.getresponse()
                if 200 <= response.status < 500:
                    expected[token] = {
                        "probe": token,
                        "host": domain,
                        "uri": path,
                        "upstream": f"127.0.0.1:{req['ports'][route['service']]}",
                        "status": response.status,
                    }
                    route_tokens[token] = index
            except (OSError, http.client.HTTPException):
                # Certificate/connection errors during the reload window are retried
                # with normal certificate verification and a fresh connection.
                pass
            finally:
                connection.close()
        log_deadline = min(deadline, time.monotonic() + 0.25)
        while expected and time.monotonic() < log_deadline:
            matched, rejected = probe_log_matches(expected)
            for token in matched:
                pending.discard(route_tokens[token])
            # Delayed log rows for requests issued by this invocation remain
            # eligible across retries. A token already observed at a wrong
            # upstream/path/status is permanently retired and cannot be repaired
            # by a later row carrying that old token.
            for token in list(expected):
                if token in rejected or route_tokens[token] not in pending:
                    del expected[token]
                    del route_tokens[token]
            if not pending:
                return
            if expected:
                time.sleep(min(0.05, max(0, log_deadline - time.monotonic())))
        if pending:
            time.sleep(min(0.1, max(0, deadline - time.monotonic())))
    raise RuntimeError("TLS probe deadline expired before every expected upstream was confirmed")


def verify(req):
    validate(req)
    state = read_state(req["subdomain"])
    guard_quarantine(req, state)
    completed_deactivation(state)
    current = state["current"]
    if (
        not current
        or current["release"] != req["release"]
        or current["request"]["routes"] != req["routes"]
        or current["request"]["ports"] != req["ports"]
    ):
        raise ValueError("Requested release is not the current route")
    try:
        probe_routes(req)
    except Exception:
        rollback(req)
        raise
    # Keep pending: helper verification and the worker's Store.finish() are not
    # one atomic commit. A crash between them still needs this rollback journal.
    # After a committed success it may remain until the next publish replaces it;
    # its presence alone does not mean publication is unfinished.
    state["current"]["verified"] = True
    save_state(req["subdomain"], state)
    return {"verified": True, "release": req["release"]}


def ensure_https(req):
    validate(req)
    guard_quarantine(req, read_state(req["subdomain"]))
    path = config_path(req["subdomain"])
    if not path.exists():
        apply_config(req["subdomain"], render(req, tls=False))
    renewal_config = Path("/etc/letsencrypt/renewal") / (host(req) + ".conf")
    if renewal_config.exists() and re.search(
        r"^\s*(deploy_hook|renew_hook|pre_hook|post_hook)\s*=\s*\S", renewal_config.read_text(), re.M
    ):
        raise ValueError("Managed certificate has a custom renewal hook; operator reconciliation is required")
    run(
        [
            CERTBOT,
            "certonly",
            "--no-directory-hooks",
            "--webroot",
            "--webroot-path",
            str(WEBROOT),
            "--domain",
            host(req),
            "--non-interactive",
            "--agree-tos",
            "--email",
            CONFIG["email"],
            "--keep-until-expiring",
        ],
        timeout=300,
    )
    if not (Path("/etc/letsencrypt/live") / host(req) / "fullchain.pem").exists():
        raise RuntimeError("Certbot did not produce the required certificate")
    # Certonly suppresses directory hooks to avoid reacquiring this lock. Reload here
    # so an interrupted later publish cannot leave an old in-memory certificate.
    reload_gateway()
    return {"certificate": host(req)}


def reload_gateway():
    # Existing certbot.timer invokes a root-owned directory deploy hook using --reload.
    run([NGINX, "-t"])
    run([NGINX, "-s", "reload"])
    return {"reloaded": True}


def trusted(path, directory=False):
    info = path.lstat()
    if info.st_uid != 0 or info.st_mode & 0o022 or stat.S_ISLNK(info.st_mode):
        raise ValueError(f"Root-owned non-writable path required: {path}")
    if directory and not stat.S_ISDIR(info.st_mode):
        raise ValueError("Expected root-owned directory")


def prepare_directories():
    # mkdir mode is filtered by the worker's inherited 0077 umask. Explicitly set
    # modes only after checking ownership and refusing symlinks.
    trusted(WEBROOT.parent, directory=True)
    if not WEBROOT.parent.stat().st_mode & 0o001:
        raise ValueError("ACME webroot parent must be traversable by the Nginx worker")
    STATE.mkdir(mode=0o700, parents=True, exist_ok=True)
    trusted(STATE, directory=True)
    STATE.chmod(0o700)
    WEBROOT.mkdir(mode=0o755, exist_ok=True)
    trusted(WEBROOT, directory=True)
    WEBROOT.chmod(0o755)


def main():
    global CONFIG, LOCK_FD
    if os.geteuid() != 0:
        raise ValueError("Gateway helper must run as root")
    trusted(Path(__file__))
    for parent in (Path("/usr/local/libexec"), CONFIG_FILE.parent, NGINX_DIR):
        trusted(parent, directory=True)
    trusted(CONFIG_FILE)
    CONFIG = json.loads(CONFIG_FILE.read_text())
    if set(CONFIG) != {"base_domain", "email", "allowed_uid", "port_start", "port_end"}:
        raise ValueError("Invalid root-owned gateway configuration")
    if (
        not re.fullmatch(r"[a-z0-9](?:[a-z0-9.-]{1,251}[a-z0-9])?", CONFIG["base_domain"])
        or ".." in CONFIG["base_domain"]
    ):
        raise ValueError("Invalid configured domain")
    if not isinstance(CONFIG["email"], str) or not re.fullmatch(r"[^\s@]+@[^\s@]+\.[^\s@]+", CONFIG["email"]):
        raise ValueError("Invalid ACME email")
    if type(CONFIG["allowed_uid"]) is not int or CONFIG["allowed_uid"] <= 0:
        raise ValueError("A nonroot worker UID is required")
    if (
        any(type(CONFIG[key]) is not int for key in ("port_start", "port_end"))
        or not 1024 <= CONFIG["port_start"] <= CONFIG["port_end"] <= 65535
    ):
        raise ValueError("Invalid configured port range")
    renewal = sys.argv[1:] == ["--reload"] and os.getuid() == 0 and not os.environ.get("SUDO_UID")
    if sys.argv[1:] and not renewal:
        raise ValueError("No command-line arguments are accepted from the worker")
    if not renewal and os.environ.get("SUDO_UID") != str(CONFIG["allowed_uid"]):
        raise ValueError("Caller is not the configured worker UID")
    prepare_directories()
    lock_fd = os.open("/run/lock/awesome-gateway.lock", os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
    lock_info = os.fstat(lock_fd)
    if lock_info.st_uid != 0 or lock_info.st_mode & 0o022:
        os.close(lock_fd)
        raise ValueError("Gateway lock must be owned by root and not writable by other users")
    with os.fdopen(lock_fd, "a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        LOCK_FD = lock.fileno()
        if renewal:
            print(json.dumps({"ok": True, **reload_gateway()}))
            return
        payload = sys.stdin.buffer.read(65537)
        if len(payload) > 65536:
            raise ValueError("Gateway request too large")
        req = json.loads(payload)
        validate(req)
        if req["op"] == "check":
            for binary in (NGINX, CERTBOT):
                trusted(Path(binary))
                if not os.access(binary, os.X_OK):
                    raise ValueError("Nginx and Certbot must be installed")
            run([NGINX, "-t"])
            print(
                json.dumps(
                    {
                        "ok": True,
                        "ready": True,
                        "base_domain": CONFIG["base_domain"],
                        "port_start": CONFIG["port_start"],
                        "port_end": CONFIG["port_end"],
                    }
                )
            )
            return
        log_config = NGINX_DIR / "00-awesome-probes.conf"
        if log_config.exists() and log_config.read_text() != PROBE_LOGGING:
            raise ValueError("Managed logging configuration has been modified")
        if not log_config.exists():
            atomic(log_config, PROBE_LOGGING)
        if req["op"] == "verify_status":
            result = {"current": read_state(req["subdomain"])["current"]}
        else:
            result = globals()[req["op"]](req)
        print(json.dumps({"ok": True, **result}))


if __name__ == "__main__":
    try:
        main()
    except Exception as exc:
        print(json.dumps({"ok": False, "error": str(exc)[:8192]}))
        sys.exit(1)
