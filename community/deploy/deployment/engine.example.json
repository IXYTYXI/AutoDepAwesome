{
  "state_dir": "/var/lib/ows-deployment",
  "base_domain": "awesome.guanghexinzhi.cn",
  "public_url": "https://community.example.com",
  "auth_mode": "feishu",
  "feishu_app_id": "REPLACE_WITH_COMMUNITY_APP_ID",
  "feishu_tenant_key": "REPLACE_WITH_TENANT_KEY",
  "feishu_app_secret_file": "/etc/ows-deployment/feishu-secret",
  "feishu_eligibility_mode": "continuous",
  "docker_host": "unix:///run/user/1001/docker.sock",
  "builder_name": "ows-deploy-builder",
  "port_start": 22000,
  "port_end": 22999,
  "max_cpu": 2,
  "max_memory_mib": 2048,
  "max_app_memory_mib": 500,
  "required_free_mib": 4096,
  "docker_storage_limit_mib": 20480,
  "repo_size_limit_mib": 256,
  "build_timeout": 900,
  "build_network": "none",
  "runtime_network": "internal",
  "storage_backend": "xfs-project",
  "runtime_user": "65532:65532",
  "gateway_command": ["sudo", "-n", "/usr/local/libexec/awesome-gateway"]
}
